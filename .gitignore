# Keep loose images out of the repo root (screenshots, exports) while tracking
# everything under assets/ — including the icon masters in assets/source/.
*.png
!assets/**/*.png

# Local render/test harnesses. These are never loaded by the manifest and must
# not reach a store package — a reviewer finding an unexplained 900-line HTML
# file in the bundle is a rejection risk, and they carry no user-facing code.
ui/__sbx.html
ui/.__drive.js
ui/done-sandbox.html
ui/done-sandbox.js

# Development dependencies and generated artifacts
/build/
/mobile/node_modules/
/mobile/dist/
/mobile/.firebase/
/mobile/firebase-debug*.log
/mobile/.env*
!mobile/public/icon.png

# Internal notes — kept in the private dev folder, never published
CLAUDE.md
docs/FIXLOG.md
docs/GOOGLE_SETUP.md
docs/STORE_LISTING.md
docs/STORY.md
docs/MARKET_EVALUATION.md
docs/PROPOSALS_*.md
docs/SESSION_*.md
docs/NICE_TRY_claude-code-sessions.*
docs/store-screenshots/
