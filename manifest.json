{
  "manifest_version": 3,
  "name": "Nice Try",
  "version": "1.0.0",
  "description": "Blocks distracting tabs with a wall you must justify past. Reads tab titles only; may close a tab you fail to justify.",
  "permissions": ["tabs", "storage", "alarms", "notifications", "scripting", "idle", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Nice Try",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/logo-mark.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
